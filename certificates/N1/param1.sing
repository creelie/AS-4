-x(14)*x(8) + x(5)*x(9) + x(7),
x(1)*x(12) + x(9) + 1,
x(1)*x(2) - x(11) + x(3)*x(9),
-x(1)*x(7) - x(15)*x(9) + x(8),
-x(1)*x(6) - x(13) + x(3),
-x(14)*x(3) + x(2) + x(6),
-x(15)*x(6) + x(3)*x(5) + x(4),
c14 + x(7),
-c13 - x(1)*x(4),
